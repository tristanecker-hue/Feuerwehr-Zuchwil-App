rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function angemeldet() { return request.auth != null; }

    // Fortschritt: nur der eigene
    match /fwz_progress/{uid} {
      allow read, write: if angemeldet() && request.auth.uid == uid;
    }

    // Konfiguration / Drehleiter-Daten: alle angemeldeten lesen und schreiben
    match /fwz_config/{id} {
      allow read, write: if angemeldet();
    }

    // Lektionen (gemeinsame Dateien)
    match /fwz_lessons/{id} { allow read, write: if angemeldet(); }
    match /fwz_parts/{id}   { allow read, write: if angemeldet(); }

    // Eigene Dateien: nur der Besitzer
    match /fwz_files/{id} {
      allow create: if angemeldet() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if angemeldet() && resource.data.uid == request.auth.uid;
    }
    match /fwz_fparts/{id} {
      allow create: if angemeldet() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if angemeldet() && resource.data.uid == request.auth.uid;
    }

    // NEU: Geräte-Übersicht und Nutzungsprotokoll
    match /fwz_presence/{id} { allow read, write: if angemeldet(); }
    match /fwz_log/{id}      { allow read, write: if angemeldet(); }
  }
}
